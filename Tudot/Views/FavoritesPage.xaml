<UserControl x:Class="Tudot.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock Text="还没有收藏的相册，点击相册封面右下角的心形按钮即可收藏"
                   Foreground="#999" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                   Visibility="{Binding FavoriteAlbums.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FavoriteAlbums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding Id}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Height="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.69}"
                                        Background="#F0F0F0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding CoverPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=520, IsAsync=True}"
                                               Stretch="UniformToFill"/>
                                        <Border Background="#80000000" CornerRadius="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding CountLabel}"
                                                       Foreground="White" FontSize="12" Margin="10,4"/>
                                        </Border>
                                        <!-- 取消收藏 -->
                                        <Button Tag="{Binding}" Click="UnfavoriteButton_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                ToolTip="取消收藏">
                                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="#E81123"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,12">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CreatorName}" FontSize="12" Foreground="#2563EB" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM}"
                                                   FontSize="12" Foreground="#999" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
