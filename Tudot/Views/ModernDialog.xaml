<Window x:Class="Tudot.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" KeyDown="Window_KeyDown">
    <Border Background="White" CornerRadius="12" Margin="12"
            BorderBrush="#E5E5E5" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="提示" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Margin="0,-6,-10,0" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#999"/>
                </Button>
            </Grid>

            <!-- Message -->
            <TextBlock Grid.Row="1" x:Name="MessageText" FontSize="13" Foreground="#555"
                       TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20"/>

            <!-- Input -->
            <TextBox Grid.Row="2" x:Name="InputBox" Margin="0,12,0,0" Padding="8,6"
                     VerticalContentAlignment="Center" Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Padding="14,6" Margin="0,0,8,0"
                        Cursor="Hand" Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="14,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E5E5E5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="AltButton" Content="仅移动索引" Padding="14,6" Margin="0,0,8,0"
                        Cursor="Hand" Click="AltButton_Click" Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#EAF0FE"/>
                            <Setter Property="Foreground" Value="#2563EB"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="14,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#D8E4FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="OkButton" Content="确 定" Style="{StaticResource PrimaryButton}"
                        Padding="20,6" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
