<UserControl x:Class="Tudot.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面包屑导航 -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="12,8" Margin="0,0,0,12"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全部相册" Style="{StaticResource OutlineButton}" Padding="10,4"
                        Click="BreadcrumbAll_Click" Cursor="Hand"/>
                <TextBlock Text="  /  " FontSize="14" Foreground="#999" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HomeViewTitle}" FontSize="14" Foreground="#2563EB" FontWeight="Medium"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 多选/分页工具栏（仅相册模式显示） -->
        <Grid Grid.Row="1" Margin="0,0,0,12"
              Visibility="{Binding HomeViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Albums}">
            <!-- 左：分页控件 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HomePaged, Converter={StaticResource BoolToVis}}">
                <Button Content="上一页" Style="{StaticResource OutlineButton}" Click="PrevPageButton_Click"
                        IsEnabled="{Binding CanPrevPage}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PageInfo}" FontSize="13" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="下一页" Style="{StaticResource OutlineButton}" Click="NextPageButton_Click"
                        IsEnabled="{Binding CanNextPage}"/>
            </StackPanel>
            <!-- 右：多选 + 显示方式切换 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding MultiSelectAlbumsMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SelectedAlbumCount, StringFormat={}已选 {0} 个}"
                               FontSize="12" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="全选" Style="{StaticResource OutlineButton}" Click="AlbumsSelectAllButton_Click" Margin="0,0,6,0"/>
                    <Button Content="收藏所选" Style="{StaticResource OutlineButton}" Click="FavoriteSelectedButton_Click" Margin="0,0,6,0"/>
                    <Button Content="删除所选" Style="{StaticResource DangerOutlineButton}" Click="DeleteSelectedAlbumsButton_Click" Margin="0,0,6,0"/>
                </StackPanel>
                <Button Content="多选" Style="{StaticResource OutlineButton}" Click="MultiSelectAlbumsButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="PagedModeBtn" Content="分页" Style="{StaticResource OutlineButton}" Click="PagedModeButton_Click" Margin="0,0,4,0"/>
                <Button x:Name="AllModeBtn" Content="全部" Style="{StaticResource OutlineButton}" Click="AllModeButton_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 相册模式 -->
                <ItemsControl ItemsSource="{Binding PagedAlbums}"
                              Visibility="{Binding HomeViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding Id}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu Tag="{Binding}">
                                    <MenuItem Header="编辑相册" Click="AlbumMenu_Edit"/>
                                    <MenuItem Header="收藏 / 取消收藏" Click="AlbumMenu_Favorite"/>
                                    <MenuItem Header="重命名" Click="AlbumMenu_Rename"/>
                                    <MenuItem Header="删除相册" Click="AlbumMenu_Delete"/>
                                    <Separator/>
                                    <MenuItem Header="打开文件夹位置" Click="AlbumMenu_OpenFolder"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Height="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.69}"
                                        Background="#F0F0F0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding CoverPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=520, IsAsync=True}"
                                               Stretch="UniformToFill"/>
                                        <!-- 图片/视频数量角标 -->
                                        <Border Background="#80000000" CornerRadius="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding CountLabel}"
                                                       Foreground="White" FontSize="12" Margin="10,4"/>
                                        </Border>
                                        <!-- 视频封面角标（数量角标下方） -->
                                        <Border Background="#80000000" CornerRadius="10" Width="28" Height="28"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,44,10,0"
                                                Visibility="{Binding CoverIsVideo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- 左下角标记：外部 / 缺失 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                                            <Border Background="#CC2563EB" CornerRadius="6" Margin="0,0,6,0"
                                                    Visibility="{Binding IsExternal, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="外部" Foreground="White" FontSize="11" Margin="8,3"/>
                                            </Border>
                                            <Border Background="#CCDC2626" CornerRadius="6"
                                                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="缺失" Foreground="White" FontSize="11" Margin="8,3"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- 收藏心形按钮（右下角） -->
                                        <Button Tag="{Binding}" Click="FavoriteButton_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                ToolTip="收藏 / 取消收藏">
                                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Foreground" Value="#E81123"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <!-- 多选勾选框（左上角） -->
                                        <Border CornerRadius="10" Width="22" Height="22" Margin="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#CCFFFFFF" BorderBrush="#999" BorderThickness="1"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding DataContext.MultiSelectAlbumsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,12">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CreatorName}" FontSize="12" Foreground="#2563EB" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM}"
                                                   FontSize="12" Foreground="#999" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 创作者模式 -->
            <ItemsControl ItemsSource="{Binding FilteredCreators}"
                          Visibility="{Binding HomeViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Creators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="CreatorCard_MouseLeftButtonDown" Tag="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- 方形缩略图（支持自定义图片，默认色块+首字母） -->
                                <Border Grid.Column="0"
                                        Width="{Binding DataContext.CreatorThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding DataContext.CreatorThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CornerRadius="12,0,0,12"
                                        Background="{Binding Name, Converter={StaticResource StringToColorConverter}}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Name[0]}" FontSize="44" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ThumbPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=240, IsAsync=True}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding ThumbPath, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="#333"/>
                                    <TextBlock Text="{Binding AlbumCount, StringFormat={}{0} 个相册}"
                                               FontSize="12" Foreground="#999" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding TotalImages, StringFormat={}{0} 张图片}"
                                               FontSize="12" Foreground="#999"/>
                                    <TextBlock Text="点击查看相册 →" FontSize="12" Foreground="#2563EB" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
