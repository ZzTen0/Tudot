<UserControl x:Class="Tudot.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 多选工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding MultiSelectAlbumsMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SelectedAlbumCount, StringFormat={}已选 {0} 个}"
                           FontSize="12" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="全选" Style="{StaticResource OutlineButton}" Click="AlbumsSelectAllButton_Click" Margin="0,0,6,0"/>
                <Button Content="收藏所选" Style="{StaticResource OutlineButton}" Click="FavoriteSelectedButton_Click" Margin="0,0,6,0"/>
                <Button Content="删除所选" Style="{StaticResource DangerOutlineButton}" Click="DeleteSelectedAlbumsButton_Click" Margin="0,0,6,0"/>
            </StackPanel>
            <Button Content="多选" Style="{StaticResource OutlineButton}" Click="MultiSelectAlbumsButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding Id}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu Tag="{Binding}">
                                    <MenuItem Header="编辑相册" Click="AlbumMenu_Edit"/>
                                    <MenuItem Header="收藏 / 取消收藏" Click="AlbumMenu_Favorite"/>
                                    <MenuItem Header="重命名" Click="AlbumMenu_Rename"/>
                                    <MenuItem Header="删除相册" Click="AlbumMenu_Delete"/>
                                    <Separator/>
                                    <MenuItem Header="打开文件夹位置" Click="AlbumMenu_OpenFolder"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Height="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.69}"
                                        Background="#F0F0F0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding CoverPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=520, IsAsync=True}"
                                               Stretch="UniformToFill"/>
                                        <!-- 图片数量角标 -->
                                        <Border Background="#80000000" CornerRadius="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding ImageCount, StringFormat={}{0} 张}"
                                                       Foreground="White" FontSize="12" Margin="10,4"/>
                                        </Border>
                                        <!-- 收藏心形按钮（右下角） -->
                                        <Button Tag="{Binding}" Click="FavoriteButton_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                ToolTip="收藏 / 取消收藏">
                                            <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Foreground" Value="#E81123"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <!-- 多选勾选框（左上角） -->
                                        <Border CornerRadius="10" Width="22" Height="22" Margin="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#CCFFFFFF" BorderBrush="#999" BorderThickness="1"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding DataContext.MultiSelectAlbumsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                            <Setter Property="BorderBrush" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,12">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CreatorName}" FontSize="12" Foreground="#2563EB" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM}"
                                                   FontSize="12" Foreground="#999" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
