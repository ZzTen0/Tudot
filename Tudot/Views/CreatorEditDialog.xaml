<Window x:Class="Tudot.Views.CreatorEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑创作者" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown">
    <Border Background="White" CornerRadius="12" Margin="12"
            BorderBrush="#E5E5E5" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <StackPanel Margin="24">
            <Grid>
                <TextBlock Text="编辑创作者" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Margin="0,-6,-10,0" Click="CancelButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#999"/>
                </Button>
            </Grid>

            <TextBlock Text="创作者名称" FontSize="12" Foreground="#888" Margin="0,16,0,6"/>
            <TextBox x:Name="NameTextBox" Padding="8,6" VerticalContentAlignment="Center"/>

            <TextBlock Text="所属分类" FontSize="12" Foreground="#888" Margin="0,14,0,6"/>
            <ComboBox x:Name="CategoryComboBox" Padding="8,6" VerticalContentAlignment="Center"/>

            <TextBlock Text="文件夹路径" FontSize="12" Foreground="#888" Margin="0,14,0,6"/>
            <TextBox x:Name="FolderPathTextBox" Padding="8,6" VerticalContentAlignment="Center"
                     IsReadOnly="True" Background="#F5F5F5" Foreground="#999"/>

            <TextBlock Text="自定义缩略图" FontSize="12" Foreground="#888" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="60" Height="60" CornerRadius="8" Background="#F0F0F0" ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image x:Name="ThumbPreview" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="选择图片..." Padding="14,6" Click="PickThumbButton_Click" Cursor="Hand"
                            HorizontalAlignment="Left"/>
                    <Button x:Name="ClearThumbButton" Content="清除" Padding="14,6" Margin="0,8,0,0" Cursor="Hand"
                            HorizontalAlignment="Left" Click="ClearThumbButton_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Padding="14,6" Margin="0,0,8,0" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="14,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E5E5E5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="20,6" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
