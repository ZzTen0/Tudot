<Window x:Class="Tudot.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看器" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        WindowState="Maximized" KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseMove="Window_MouseMove">
    <Grid>
        <!-- 图片区域 -->
        <Grid Background="Black" MouseLeftButtonDown="ImageArea_MouseLeftButtonDown" ClipToBounds="True">
            <Image x:Name="MainImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- 顶部信息栏（关闭按钮在右上），不操作时自动隐藏 -->
        <Border x:Name="TopBar" Background="#99000000" Height="44" VerticalAlignment="Top">
            <Grid>
                <TextBlock x:Name="InfoText" FontSize="13" Foreground="#CCC"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="800"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Click="CloseButton_Click" Cursor="Hand" ToolTip="关闭（Esc）">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- 左右翻页按钮，不操作时自动隐藏 -->
        <Border x:Name="PrevButton" Width="48" Height="48" CornerRadius="24" Background="#66000000"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
                Cursor="Hand" MouseLeftButtonDown="PrevButton_MouseDown" ToolTip="上一张（←）">
            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="NextButton" Width="48" Height="48" CornerRadius="24" Background="#66000000"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                Cursor="Hand" MouseLeftButtonDown="NextButton_MouseDown" ToolTip="下一张（→）">
            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
