<Window x:Class="Tudot.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看器" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        WindowState="Maximized" KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <Grid Grid.Row="0" Background="#CC000000" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource IconButton}" Margin="12,0,0,0"
                    Click="CloseButton_Click" Cursor="Hand">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
            </Button>
            <TextBlock Grid.Column="1" x:Name="InfoText" FontSize="13" Foreground="#CCC"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                <Button Style="{StaticResource IconButton}" Click="PrevButton_Click" Cursor="Hand"
                        ToolTip="上一张（←）">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="NextButton_Click" Cursor="Hand"
                        ToolTip="下一张（→）">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 图片区域 -->
        <Grid Grid.Row="1" Background="Black" MouseLeftButtonDown="ImageArea_MouseLeftButtonDown"
              ClipToBounds="True">
            <Image x:Name="MainImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- 点击区域：左右切换 -->
        <Grid Grid.Row="1" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>