<Window x:Class="Tudot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" Height="850" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown">
    <Border Background="White" CornerRadius="12" Margin="12"
            BorderBrush="#E5E5E5" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Margin="0,-6,-10,0" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#999"/>
                </Button>
            </Grid>

            <Border Background="#F4F7FF" BorderBrush="#DCE5FA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,4">
                <StackPanel>
                    <TextBlock Text="软件更新" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Text="选择更新来源和检查方式，重启后应用更新" Foreground="#777" FontSize="12" Margin="0,5,0,16"/>
                    <ComboBox x:Name="UpdateSourceCombo" SelectedIndex="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectionChanged="UpdateSourceCombo_SelectionChanged">
                        <ComboBoxItem Content="GitHub Release（默认）" Tag="GitHub"/>
                        <ComboBoxItem Content="本地发布目录" Tag="Local"/>
                    </ComboBox>
                    <Grid x:Name="LocalUpdateSourcePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalUpdateDirectoryBox" Padding="8,4" ToolTip="包含 latest.json 的本地更新源目录"/>
                        <Button Grid.Column="1" Content="浏览…" Padding="12,4" Margin="8,0,0,0" Click="BrowseUpdateSource_Click"/>
                    </Grid>
                    <RadioButton x:Name="AutomaticUpdateRadio" HorizontalAlignment="Left" GroupName="UpdateMode" Content="有更新时自动更新" Margin="0,0,0,12" Checked="UpdateMode_Checked"/>
                    <RadioButton x:Name="NotifyUpdateRadio" HorizontalAlignment="Left" GroupName="UpdateMode" Content="有更新时提醒用户更新" Margin="0,0,0,12" Checked="UpdateMode_Checked"/>
                    <RadioButton x:Name="DisabledUpdateRadio" HorizontalAlignment="Left" GroupName="UpdateMode" Content="不更新" Checked="UpdateMode_Checked"/>
                    <TextBlock x:Name="UpdateModeHint" TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,14,0,12"/>
                    <Separator Background="#DCE5FA"/>
                    <TextBlock x:Name="CurrentBuildText" Foreground="#777" FontSize="11" Margin="0,10,0,5"/>
                    <TextBlock x:Name="UpdateSourceText" Foreground="#777" FontSize="11" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Padding="16,7" Click="CheckUpdateButton_Click"/>
                        <Button x:Name="InstallUpdatePackageButton" Content="安装本地更新包…" Padding="16,7" Margin="8,0,0,0" Click="InstallUpdatePackage_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Text="更新模式在点击「确定」后生效。" Foreground="#888" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="库存储路径" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,16,0,0"/>
            <TextBlock Text="所有相册将按「库路径 / 创作者 / 相册」的结构整理存放"
                       FontSize="12" Foreground="#999" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" VerticalContentAlignment="Center" Padding="8,0"/>
                <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="14,6" Click="BrowseButton_Click" Cursor="Hand"/>
            </Grid>

            <!-- 缩略图尺寸 -->
            <TextBlock Text="界面尺寸" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,24,0,0"/>
            <TextBlock Text="拉动滑块可实时调整主界面中的卡片与缩略图大小"
                       FontSize="12" Foreground="#999" Margin="0,4,0,12" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="相册卡片宽度" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                <Slider x:Name="AlbumCardSlider" Grid.Column="1" Minimum="140" Maximum="560"
                        Value="{Binding AlbumCardWidth, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=AlbumCardSlider, StringFormat={}{0:0}}"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="创作者缩略图" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                <Slider x:Name="CreatorThumbSlider" Grid.Column="1" Minimum="60" Maximum="280"
                        Value="{Binding CreatorThumbSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=CreatorThumbSlider, StringFormat={}{0:0}}"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="图片缩略图" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                <Slider x:Name="ImageThumbSlider" Grid.Column="1" Minimum="90" Maximum="480"
                        Value="{Binding ImageThumbWidth, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=ImageThumbSlider, StringFormat={}{0:0}}"/>
            </Grid>

            <!-- 主页显示方式与分页 -->
            <TextBlock Text="主页显示" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,20,0,0"/>
            <TextBlock Text="分页模式按固定页数展示相册；全部模式一次平铺所有相册"
                       FontSize="12" Foreground="#999" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <RadioButton Content="分页显示" FontSize="13" Foreground="#555" GroupName="HomeMode"
                         IsChecked="{Binding HomePaged, Mode=TwoWay}"/>
            <RadioButton Content="全部显示（不分页）" FontSize="13" Foreground="#555" GroupName="HomeMode" Margin="0,8,0,0"
                         IsChecked="{Binding HomePaged, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="每页相册数" FontSize="13" Foreground="#555" VerticalAlignment="Center"/>
                <Slider x:Name="PageSizeSlider" Grid.Column="1" Minimum="8" Maximum="96" SmallChange="4" LargeChange="8"
                        Value="{Binding PageSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=PageSizeSlider, StringFormat={}{0:0}}"/>
            </Grid>

            <!-- 图片查看方式 -->
            <TextBlock Text="图片查看" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,20,0,0"/>
            <TextBlock Text="点击图片缩略图时的打开方式"
                       FontSize="12" Foreground="#999" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <RadioButton x:Name="SystemViewerRadio" Content="使用系统默认图片查看器" FontSize="13"
                         Foreground="#555" GroupName="Viewer" IsChecked="{Binding UseInternalViewer, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
            <RadioButton x:Name="InternalViewerRadio" Content="使用应用内查看器（大图 + 翻页）" FontSize="13"
                         Foreground="#555" GroupName="Viewer" Margin="0,8,0,0"
                         IsChecked="{Binding UseInternalViewer, Mode=TwoWay}"/>

            <!-- 缩略图缓存路径 -->
            <TextBlock Text="缩略图缓存路径" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,20,0,0"/>
            <TextBlock Text="留空则使用应用目录下的 Thumbs 文件夹；修改后新缩略图将写入新路径"
                       FontSize="12" Foreground="#999" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CachePathTextBox" VerticalContentAlignment="Center" Padding="8,0"
                         ToolTip="留空 = 应用目录\Thumbs"/>
                <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="14,6" Click="BrowseCacheButton_Click" Cursor="Hand"/>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#999" Margin="0,0,8,0"
                           Text="手动清除相册与图片的缩略图缓存（创作者封面缓存保留）" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="清除缓存" Padding="14,6" VerticalAlignment="Center"
                        Click="ClearCacheButton_Click" Cursor="Hand"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="恢复默认路径" Padding="14,6" Margin="0,0,8,0" Click="ResetButton_Click" Cursor="Hand"/>
                <Button Content="确 定" Style="{StaticResource PrimaryButton}" Padding="24,6" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
