<UserControl x:Class="Tudot.Views.AlbumDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButton}" Click="BackButton_Click">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedAlbum.Name}" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock FontSize="13" Foreground="#666" Margin="0,4,0,0">
                        <Run Text="{Binding SelectedAlbum.CreatorName}"/><Run Text=" · "/><Run Text="{Binding SelectedAlbum.ImageCount}"/><Run Text=" 张图片"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 多选操作栏 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding MultiSelectMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedImageCount, StringFormat={}已选 {0} 项}"
                                   FontSize="12" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="全选" Style="{StaticResource OutlineButton}" Click="SelectAllButton_Click" Margin="0,0,6,0"/>
                        <Button Content="重命名所选" Style="{StaticResource OutlineButton}" Click="BatchRenameSelectedButton_Click" Margin="0,0,6,0"/>
                        <Button Content="删除所选" Style="{StaticResource DangerOutlineButton}" Click="BatchDeleteButton_Click" Margin="0,0,6,0"/>
                    </StackPanel>
                    <Button Content="多选" Style="{StaticResource OutlineButton}" Click="MultiSelectButton_Click" Margin="0,0,12,0"/>
                    <!-- 视图模式切换 -->
                    <Button x:Name="CompactModeBtn" Style="{StaticResource IconButton}" Margin="0,0,4,0" ToolTip="紧凑模式"
                            Click="CompactModeButton_Click">
                        <TextBlock x:Name="CompactModeIcon" Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <Button x:Name="GridModeBtn" Style="{StaticResource IconButton}" Margin="0,0,12,0" ToolTip="网格模式"
                            Click="GridModeButton_Click">
                        <TextBlock x:Name="GridModeIcon" Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <ComboBox x:Name="ImageSortCombo" Width="86" VerticalContentAlignment="Center"
                              Padding="6,4" Margin="0,0,12,0" FontSize="12" SelectedIndex="0"
                              SelectionChanged="ImageSortCombo_SelectionChanged" ToolTip="排序（视频永远在最后）">
                        <ComboBoxItem Content="按名称" Tag="Name"/>
                        <ComboBoxItem Content="按日期" Tag="Date"/>
                        <ComboBoxItem Content="按大小" Tag="Size"/>
                    </ComboBox>
                    <Button Content="打开文件夹" Style="{StaticResource OutlineButton}" Click="OpenFolderButton_Click" Margin="0,0,8,0"/>
                    <Button Content="编辑相册" Style="{StaticResource OutlineButton}" Click="EditAlbumButton_Click" Margin="0,0,8,0"/>
                    <Button Content="设置封面" Style="{StaticResource OutlineButton}" Click="SetCoverButton_Click" Margin="0,0,8,0"/>
                    <Button Content="批量重命名" Style="{StaticResource OutlineButton}" Click="BatchRenameButton_Click" Margin="0,0,8,0"/>
                    <Button Content="删除相册" Style="{StaticResource DangerOutlineButton}" Click="DeleteAlbumButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Image Grid -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CurrentAlbumImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,16,16" Cursor="Hand"
                              MouseLeftButtonDown="ImageItem_Click" Tag="{Binding}">
                            <Grid.ContextMenu>
                                <ContextMenu Tag="{Binding}">
                                    <MenuItem Header="打开" Click="ImageMenu_Open"/>
                                    <MenuItem Header="重命名" Click="ImageMenu_Rename"/>
                                    <MenuItem Header="删除" Click="ImageMenu_Delete"/>
                                    <Separator/>
                                    <MenuItem Header="属性" Click="ImageMenu_Properties"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <!-- 紧凑模式：固定行高，宽度按原图比例自适应，自动填满空档 -->
                            <Grid Visibility="{Binding DataContext.ThumbViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Compact}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="6" ClipToBounds="True"
                                        Height="{Binding DataContext.ImageThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid>
                                        <Image Source="{Binding FilePath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=360, IsAsync=True}"
                                               Stretch="Uniform"/>
                                        <!-- 视频播放标识 -->
                                        <Border Background="#99000000" CornerRadius="14" Padding="10,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding FileType, Converter={StaticResource FileTypeToVisibilityConverter}}">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#333"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                               MaxWidth="{Binding DataContext.ImageThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=1.2}"/>
                                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                               FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 网格模式：固定宽高，图像按比例裁切，布局整齐 -->
                            <Grid Width="{Binding DataContext.ImageThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Visibility="{Binding DataContext.ThumbViewMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Grid}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="6" ClipToBounds="True"
                                        Height="{Binding DataContext.ImageThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.75}">
                                    <Grid>
                                        <Image Source="{Binding FilePath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=360, IsAsync=True}"
                                               Stretch="UniformToFill"/>
                                        <!-- 视频播放标识 -->
                                        <Border Background="#99000000" CornerRadius="14" Padding="10,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding FileType, Converter={StaticResource FileTypeToVisibilityConverter}}">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#333"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                               FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- 多选覆盖层：左上角勾选框 + 选中高亮 -->
                            <Border CornerRadius="6" IsHitTestVisible="False"
                                    Visibility="{Binding DataContext.MultiSelectMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                <Setter Property="Background" Value="#222563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border CornerRadius="10" Width="20" Height="20" Margin="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#CCFFFFFF" BorderBrush="#999" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
