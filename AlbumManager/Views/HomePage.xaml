<UserControl x:Class="AlbumManager.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding Id}">
                            <Border.ContextMenu>
                                <ContextMenu Tag="{Binding}">
                                    <MenuItem Header="编辑相册" Click="AlbumMenu_Edit"/>
                                    <MenuItem Header="重命名" Click="AlbumMenu_Rename"/>
                                    <MenuItem Header="删除相册" Click="AlbumMenu_Delete"/>
                                    <Separator/>
                                    <MenuItem Header="打开文件夹位置" Click="AlbumMenu_OpenFolder"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Height="{Binding DataContext.AlbumCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.69}"
                                        Background="#F0F0F0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding CoverPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=520, IsAsync=True}"
                                               Stretch="UniformToFill"/>
                                        <!-- 图片数量角标 -->
                                        <Border Background="#80000000" CornerRadius="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <TextBlock Text="{Binding ImageCount, StringFormat={}{0} 张}"
                                                       Foreground="White" FontSize="12" Margin="10,4"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,12">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CreatorName}" FontSize="12" Foreground="#2563EB" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM}"
                                                   FontSize="12" Foreground="#999" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
