<UserControl x:Class="AlbumManager.Views.CreatorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <TextBlock Text="管理创作者信息，点击标签可查看该创作者的全部相册" Foreground="#666" VerticalAlignment="Center"/>
                <Button Content="添加创作者" Style="{StaticResource PrimaryButton}" Padding="14,8"
                        HorizontalAlignment="Right" Click="AddCreatorButton_Click"/>
            </Grid>
        </Border>

        <!-- Creator Cards -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Creators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- 方形缩略图（支持自定义图片，默认色块+首字母） -->
                                <Border Grid.Column="0"
                                        Width="{Binding DataContext.CreatorThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding DataContext.CreatorThumbSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CornerRadius="12,0,0,12"
                                        Background="{Binding Name, Converter={StaticResource StringToColorConverter}}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Name[0]}" FontSize="44" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ThumbPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=240, IsAsync=True}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding ThumbPath, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#333" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="EditCreatorButton_Click" ToolTip="编辑">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="#666"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="DeleteCreatorButton_Click" ToolTip="删除">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="#999"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding AlbumCount, StringFormat={}{0} 个相册}"
                                               FontSize="12" Foreground="#999" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding TotalImages, StringFormat={}{0} 张图片}"
                                               FontSize="12" Foreground="#999"/>
                                    <Button Content="查看相册" Tag="{Binding Id}" Click="ViewAlbumsButton_Click"
                                            Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left" Cursor="Hand"
                                            Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Padding" Value="14,6"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
