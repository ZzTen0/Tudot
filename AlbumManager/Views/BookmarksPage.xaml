<UserControl x:Class="AlbumManager.Views.BookmarksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <TextBlock Text="收藏和记录喜欢的图片网址" Foreground="#666" VerticalAlignment="Center"/>
                <Button Content="添加网址" HorizontalAlignment="Right" Click="AddBookmarkButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Bookmark Cards -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" Background="White" CornerRadius="12" Margin="0,0,20,20"
                                Effect="{StaticResource CardShadow}" Cursor="Hand"
                                MouseLeftButtonDown="BookmarkItem_Click" Tag="{Binding Url}">
                            <StackPanel Margin="20">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="48" Height="48" CornerRadius="8"
                                                Background="{Binding Title, Converter={StaticResource StringToColorConverter}}">
                                            <TextBlock Text="&#xE167;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="190">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="#333"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Url}" FontSize="12" Foreground="#999" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-8,-12,0" Click="DeleteBookmarkButton_Click" ToolTip="删除">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#999"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding CreatedDate, StringFormat=收藏于 yyyy-MM-dd}"
                                           FontSize="11" Foreground="#999" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
