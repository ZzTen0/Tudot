<Window x:Class="AlbumManager.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在导入" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Border Background="White" CornerRadius="12" Margin="12"
            BorderBrush="#E5E5E5" BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <StackPanel Margin="24">
            <TextBlock Text="正在导入相册" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
            <TextBlock x:Name="StatusText" Text="准备中..." FontSize="12" Foreground="#888"
                       Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,14,0,0"
                         Foreground="#2563EB" Background="#F0F0F0" BorderThickness="0"/>
            <TextBlock x:Name="CountText" Text="0 / 0" FontSize="12" Foreground="#999"
                       HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
